<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The bundled local agent inherits the app sandbox; this exception lets
	     it read AppleSMC (fans/temperatures) exactly like Stats/Sensei do. -->
	<key>com.apple.security.temporary-exception.iokit-user-client-class</key>
	<array>
		<string>AppleSMCClient</string>
	</array>
</dict>
</plist>
